<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/page_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">
        <ImageButton android:id="@+id/btn_prev_list" android:layout_width="36dp" android:layout_height="36dp"
            android:src="@drawable/ic_chev_left" android:tint="@color/text_sub"
            android:background="?android:attr/selectableItemBackgroundBorderless" />
        <TextView android:id="@+id/tv_month_list"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:gravity="center" android:text="2026年02月" android:textSize="18sp"
            android:textStyle="bold" android:textColor="@color/text_main" />
        <ImageButton android:id="@+id/btn_next_list" android:layout_width="36dp" android:layout_height="36dp"
            android:src="@drawable/ic_chev_right" android:tint="@color/text_sub"
            android:background="?android:attr/selectableItemBackgroundBorderless" />
    </LinearLayout>


    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:overScrollMode="never"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:id="@+id/book_row_list"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_seg_track"
            android:padding="3dp" />
    </HorizontalScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/bg_seg_track"
        android:padding="3dp"
        android:layout_marginBottom="10dp">

        <TextView android:id="@+id/chip_all"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:gravity="center" android:paddingTop="8dp" android:paddingBottom="8dp"
            android:text="全部" android:textSize="13sp" android:textColor="@color/chip_text" />
        <TextView android:id="@+id/chip_expense"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:gravity="center" android:paddingTop="8dp" android:paddingBottom="8dp"
            android:text="支出" android:textSize="13sp" android:textColor="@color/chip_text" />
        <TextView android:id="@+id/chip_income"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:gravity="center" android:paddingTop="8dp" android:paddingBottom="8dp"
            android:text="收入" android:textSize="13sp" android:textColor="@color/chip_text" />
        <TextView android:id="@+id/chip_transfer"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:gravity="center" android:paddingTop="8dp" android:paddingBottom="8dp"
            android:text="转账" android:textSize="13sp" android:textColor="@color/chip_text" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">
        <EditText android:id="@+id/et_search"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_input"
            android:padding="10dp"
            android:singleLine="true"
            android:hint="搜索分类 / 备注"
            android:textSize="13sp"
            android:textColor="@color/text_main"
            android:textColorHint="@color/icon_gray" />
        <TextView android:id="@+id/btn_filter"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:padding="10dp"
            android:text="筛选" android:textSize="13sp" android:textStyle="bold"
            android:textColor="@color/primary"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <TextView android:id="@+id/tv_list_summary"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="" android:textSize="12sp" android:textColor="@color/text_sub"
        android:layout_marginBottom="6dp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/list_records"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@null"
            android:scrollbars="none"
            android:overScrollMode="never"
            android:listSelector="@android:color/transparent" />

        <TextView
            android:id="@+id/tv_empty_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="这个月还没有记录&#10;去「记账」页点 ＋ 添加吧"
            android:textSize="13sp"
            android:textColor="@color/text_sub"
            android:lineSpacingExtra="4dp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/row_bulk_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="horizontal"
            android:background="@drawable/bg_card"
            android:elevation="8dp"
            android:padding="8dp"
            android:visibility="gone">
            <TextView android:id="@+id/btn_bulk_cancel"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:padding="12dp" android:text="取消" android:textSize="14sp"
                android:textColor="@color/text_sub" />
            <TextView android:id="@+id/btn_bulk_recat"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:gravity="center" android:padding="12dp"
                android:text="改分类" android:textSize="14sp" android:textColor="@color/primary" />
            <TextView android:id="@+id/btn_bulk_delete"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:padding="12dp" android:text="删除所选" android:textSize="14sp"
                android:textStyle="bold" android:textColor="@color/expense" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
