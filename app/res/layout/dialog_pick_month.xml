<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="22dp" android:paddingEnd="22dp"
    android:paddingTop="16dp" android:paddingBottom="10dp">

    <TextView
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="导出当月 Excel" android:textSize="16sp" android:textStyle="bold"
        android:textColor="@color/text_main" />
    <TextView
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="表格包含所选月份的收支明细与月度汇总"
        android:textSize="12sp" android:textColor="@color/text_sub"
        android:layout_marginTop="2dp" />

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:layout_marginTop="14dp">
        <ImageButton android:id="@+id/btn_pm_prev"
            android:layout_width="40dp" android:layout_height="40dp"
            android:src="@drawable/ic_chev_left" android:tint="@color/text_main"
            android:background="?android:attr/selectableItemBackgroundBorderless" />
        <TextView android:id="@+id/tv_pm_month"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:gravity="center"
            android:textSize="17sp" android:textStyle="bold"
            android:textColor="@color/text_main" />
        <ImageButton android:id="@+id/btn_pm_next"
            android:layout_width="40dp" android:layout_height="40dp"
            android:src="@drawable/ic_chev_right" android:tint="@color/text_main"
            android:background="?android:attr/selectableItemBackgroundBorderless" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="10dp">
        <TextView android:id="@+id/btn_pm_cancel"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginEnd="10dp"
            android:gravity="center" android:padding="11dp"
            android:text="取消" android:textSize="14sp"
            android:textColor="@color/chip_text"
            android:background="@drawable/bg_btn_ghost" />
        <TextView android:id="@+id/btn_pm_ok"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center" android:padding="11dp"
            android:text="导出" android:textSize="14sp" android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_btn_primary" />
    </LinearLayout>
</LinearLayout>
