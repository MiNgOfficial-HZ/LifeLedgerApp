<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingBottom="8dp">

    <LinearLayout
        android:id="@+id/row_inner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/bg_card"
        android:elevation="1dp"
        android:padding="12dp"
        android:gravity="center_vertical"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?android:attr/selectableItemBackground">

        <TextView android:id="@+id/tv_emoji"
            android:layout_width="40dp" android:layout_height="40dp"
            android:background="@drawable/bg_emoji"
            android:gravity="center"
            android:textSize="18sp" />

        <LinearLayout
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical"
            android:layout_marginStart="12dp" android:layout_marginEnd="8dp">
            <TextView android:id="@+id/tv_title"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="15sp" android:textStyle="bold"
                android:textColor="@color/text_main"
                android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/tv_sub"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="12sp" android:textColor="@color/text_sub"
                android:layout_marginTop="3dp"
                android:maxLines="2" android:ellipsize="end" />
        </LinearLayout>

        <TextView android:id="@+id/tv_amount"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="16sp" android:textStyle="bold"
            android:textColor="@color/text_main" />

        <ImageButton android:id="@+id/btn_edit"
            android:layout_width="34dp" android:layout_height="34dp"
            android:src="@drawable/ic_edit" android:tint="@color/icon_gray"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:layout_marginStart="2dp" />
        <ImageButton android:id="@+id/btn_delete"
            android:layout_width="34dp" android:layout_height="34dp"
            android:src="@drawable/ic_delete" android:tint="@color/icon_gray"
            android:background="?android:attr/selectableItemBackgroundBorderless" />
    </LinearLayout>
</FrameLayout>
