<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="22dp" android:paddingEnd="22dp"
    android:paddingTop="16dp" android:paddingBottom="10dp">

    <TextView android:id="@+id/tv_at_title"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="新建出游" android:textSize="16sp" android:textStyle="bold"
        android:textColor="@color/text_main" />

    <EditText android:id="@+id/et_trip_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_input"
        android:padding="12dp"
        android:hint="出游名称，例如：苏州两日游"
        android:textColor="@color/text_main"
        android:textColorHint="@color/icon_gray"
        android:textSize="15sp"
        android:maxLength="20"
        android:maxLines="1" />

    <LinearLayout android:id="@+id/row_trip_start"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_input"
        android:padding="12dp"
        android:layout_marginTop="12dp"
        android:clickable="true" android:focusable="true"
        android:foreground="?android:attr/selectableItemBackground">
        <ImageView android:layout_width="18dp" android:layout_height="18dp"
            android:src="@drawable/ic_calendar" android:tint="@color/icon_gray" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="开始时间" android:textSize="13sp"
            android:textColor="@color/text_sub" />
        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
        <TextView android:id="@+id/tv_trip_start"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="14sp" android:textColor="@color/text_main" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="10dp">
        <TextView android:id="@+id/btn_at_cancel"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginEnd="10dp"
            android:gravity="center" android:padding="11dp"
            android:text="取消" android:textSize="14sp"
            android:textColor="@color/chip_text"
            android:background="@drawable/bg_btn_ghost" />
        <TextView android:id="@+id/btn_at_save"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center" android:padding="11dp"
            android:text="创建" android:textSize="14sp" android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_btn_primary" />
    </LinearLayout>
</LinearLayout>
