<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:scrollbars="none"
    android:overScrollMode="never"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="@color/page_bg">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">
            <ImageButton android:id="@+id/btn_prev_an" android:layout_width="36dp" android:layout_height="36dp"
                android:src="@drawable/ic_chev_left" android:tint="@color/text_sub"
                android:background="?android:attr/selectableItemBackgroundBorderless" />
            <TextView android:id="@+id/tv_month_an"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:gravity="center" android:text="2026年02月" android:textSize="18sp"
                android:textStyle="bold" android:textColor="@color/text_main" />
            <ImageButton android:id="@+id/btn_next_an" android:layout_width="36dp" android:layout_height="36dp"
                android:src="@drawable/ic_chev_right" android:tint="@color/text_sub"
                android:background="?android:attr/selectableItemBackgroundBorderless" />
        </LinearLayout>


    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:overScrollMode="never"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:id="@+id/book_row_an"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_seg_track"
            android:padding="3dp" />
    </HorizontalScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:background="@drawable/bg_card" android:elevation="1dp"
                android:padding="12dp" android:orientation="vertical" android:gravity="center"
                android:layout_marginEnd="8dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="总收入" android:textSize="11sp" android:textColor="@color/text_sub" />
                <TextView android:id="@+id/tv_an_income"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="5dp" android:text="0" android:textSize="15sp"
                    android:textStyle="bold" android:textColor="@color/income" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:background="@drawable/bg_card" android:elevation="1dp"
                android:padding="12dp" android:orientation="vertical" android:gravity="center"
                android:layout_marginEnd="8dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="总支出" android:textSize="11sp" android:textColor="@color/text_sub" />
                <TextView android:id="@+id/tv_an_expense"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="5dp" android:text="0" android:textSize="15sp"
                    android:textStyle="bold" android:textColor="@color/expense" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:background="@drawable/bg_card" android:elevation="1dp"
                android:padding="12dp" android:orientation="vertical" android:gravity="center">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="结余" android:textSize="11sp" android:textColor="@color/text_sub" />
                <TextView android:id="@+id/tv_an_balance"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="5dp" android:text="0" android:textSize="15sp"
                    android:textStyle="bold" android:textColor="@color/income" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:elevation="1dp"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="收支占比" android:textSize="15sp" android:textStyle="bold"
                android:textColor="@color/text_main" />

            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/bg_seg_track"
                android:padding="3dp"
                android:layout_marginTop="12dp">
                <TextView android:id="@+id/chip_exp_out"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:gravity="center" android:paddingTop="7dp" android:paddingBottom="7dp"
                    android:text="支出占比" android:textSize="13sp" android:textColor="@color/chip_text" />
                <TextView android:id="@+id/chip_inc_out"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:gravity="center" android:paddingTop="7dp" android:paddingBottom="7dp"
                    android:text="收入占比" android:textSize="13sp" android:textColor="@color/chip_text" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/bg_seg_track"
                android:padding="3dp"
                android:layout_marginTop="8dp">
                <TextView android:id="@+id/chip_lv1"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:gravity="center" android:paddingTop="7dp" android:paddingBottom="7dp"
                    android:text="按一级分类" android:textSize="13sp" android:textColor="@color/chip_text" />
                <TextView android:id="@+id/chip_lv2"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:gravity="center" android:paddingTop="7dp" android:paddingBottom="7dp"
                    android:text="按二级分类" android:textSize="13sp" android:textColor="@color/chip_text" />
            </LinearLayout>

            <com.lifebook.ledger.view.PieChartView
                android:id="@+id/pie_chart"
                android:layout_width="match_parent"
                android:layout_height="210dp"
                android:layout_marginTop="8dp" />

            <TextView android:id="@+id/tv_pie_empty"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center" android:text="本月暂无数据，先记一笔吧"
                android:textSize="12sp" android:textColor="@color/text_sub"
                android:paddingTop="10dp" android:paddingBottom="10dp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/legend_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="6dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:elevation="1dp"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="本月每日支出" android:textSize="15sp" android:textStyle="bold"
                android:textColor="@color/text_main" />

            <com.lifebook.ledger.view.BarChartView
                android:id="@+id/bar_chart"
                android:layout_width="match_parent"
                android:layout_height="170dp"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_tip_card"
            android:elevation="0dp"
            android:padding="16dp"
            android:layout_marginBottom="20dp">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="智能建议" android:textSize="15sp" android:textStyle="bold"
                android:textColor="@color/chip_sel_text" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="基于本机记录自动生成分析，数据不会上传"
                android:textSize="11sp" android:textColor="@color/text_sub"
                android:layout_marginTop="2dp" />
            <LinearLayout
                android:id="@+id/tips_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="8dp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
