<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/page_bg">

    <FrameLayout
        android:id="@+id/page_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <include layout="@layout/page_home" android:id="@+id/page_home" />
        <include layout="@layout/page_list" android:id="@+id/page_list" />
        <include layout="@layout/page_travel" android:id="@+id/page_travel" />
        <include layout="@layout/page_analysis" android:id="@+id/page_analysis" />
        <include layout="@layout/page_settings" android:id="@+id/page_settings" />
    </FrameLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="@color/divider" />

    <LinearLayout
        android:id="@+id/bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="62dp"
        android:orientation="horizontal"
        android:background="@color/card_bg"
        android:elevation="0dp">

        <LinearLayout android:id="@+id/tab_home"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:layout_marginStart="8dp" android:layout_marginEnd="4dp"
            android:layout_marginTop="6dp" android:layout_marginBottom="6dp"
            android:orientation="vertical" android:gravity="center"
            android:clickable="true" android:focusable="true">
            <ImageView android:id="@+id/icon_home" android:layout_width="24dp" android:layout_height="24dp"
                android:src="@drawable/ic_home" android:tint="@color/icon_gray" />
            <TextView android:id="@+id/label_home" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="2dp" android:text="记账" android:textSize="11sp" android:textColor="@color/icon_gray" />
        </LinearLayout>

        <LinearLayout android:id="@+id/tab_list"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:layout_marginStart="4dp" android:layout_marginEnd="4dp"
            android:layout_marginTop="6dp" android:layout_marginBottom="6dp"
            android:orientation="vertical" android:gravity="center"
            android:clickable="true" android:focusable="true">
            <ImageView android:id="@+id/icon_list" android:layout_width="24dp" android:layout_height="24dp"
                android:src="@drawable/ic_list" android:tint="@color/icon_gray" />
            <TextView android:id="@+id/label_list" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="2dp" android:text="明细" android:textSize="11sp" android:textColor="@color/icon_gray" />
        </LinearLayout>

        <LinearLayout android:id="@+id/tab_travel"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:layout_marginStart="4dp" android:layout_marginEnd="4dp"
            android:layout_marginTop="6dp" android:layout_marginBottom="6dp"
            android:orientation="vertical" android:gravity="center"
            android:clickable="true" android:focusable="true">
            <ImageView android:id="@+id/icon_travel" android:layout_width="24dp" android:layout_height="24dp"
                android:src="@drawable/ic_travel" android:tint="@color/icon_gray" />
            <TextView android:id="@+id/label_travel" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="2dp" android:text="出游" android:textSize="11sp" android:textColor="@color/icon_gray" />
        </LinearLayout>

        <LinearLayout android:id="@+id/tab_analysis"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:layout_marginStart="4dp" android:layout_marginEnd="4dp"
            android:layout_marginTop="6dp" android:layout_marginBottom="6dp"
            android:orientation="vertical" android:gravity="center"
            android:clickable="true" android:focusable="true">
            <ImageView android:id="@+id/icon_analysis" android:layout_width="24dp" android:layout_height="24dp"
                android:src="@drawable/ic_chart" android:tint="@color/icon_gray" />
            <TextView android:id="@+id/label_analysis" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="2dp" android:text="分析" android:textSize="11sp" android:textColor="@color/icon_gray" />
        </LinearLayout>

        <LinearLayout android:id="@+id/tab_settings"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:layout_marginStart="4dp" android:layout_marginEnd="8dp"
            android:layout_marginTop="6dp" android:layout_marginBottom="6dp"
            android:orientation="vertical" android:gravity="center"
            android:clickable="true" android:focusable="true">
            <ImageView android:id="@+id/icon_settings" android:layout_width="24dp" android:layout_height="24dp"
                android:src="@drawable/ic_settings" android:tint="@color/icon_gray" />
            <TextView android:id="@+id/label_settings" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="2dp" android:text="管理" android:textSize="11sp" android:textColor="@color/icon_gray" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
