<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet_top"
    android:scrollbars="none"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <View
            android:layout_width="36dp" android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_handle" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="14dp">
            <TextView android:id="@+id/tv_td_emoji"
                android:layout_width="30dp" android:layout_height="30dp"
                android:gravity="center" android:textSize="16sp" />
            <TextView android:id="@+id/tv_td_name"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:textSize="17sp" android:textStyle="bold"
                android:textColor="@color/text_main"
                android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/tv_td_status"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="10sp" android:textStyle="bold"
                android:paddingStart="8dp" android:paddingEnd="8dp"
                android:paddingTop="3dp" android:paddingBottom="3dp"
                android:layout_marginEnd="8dp" />
            <ImageButton android:id="@+id/btn_td_close"
                android:layout_width="32dp" android:layout_height="32dp"
                android:src="@drawable/ic_clear" android:tint="@color/icon_gray"
                android:background="?android:attr/selectableItemBackgroundBorderless" />
        </LinearLayout>

        <TextView android:id="@+id/tv_td_range"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="12sp" android:textColor="@color/text_sub"
            android:layout_marginTop="2dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="12dp">
            <TextView android:id="@+id/tv_td_total_label"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="13sp" android:textColor="@color/text_sub" />
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
            <TextView android:id="@+id/tv_td_total"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="20sp" android:textStyle="bold"
                android:textColor="@color/expense" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">
            <TextView android:id="@+id/btn_td_add"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:layout_marginEnd="8dp"
                android:gravity="center" android:padding="12dp"
                android:text="＋ 记一笔" android:textSize="14sp" android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_btn_primary" />
            <TextView android:id="@+id/btn_td_finish"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center" android:padding="12dp"
                android:text="结束出游" android:textSize="14sp" android:textStyle="bold"
                android:textColor="@color/primary"
                android:background="@drawable/bg_btn_ghost"
                android:visibility="gone" />
            <TextView android:id="@+id/btn_td_addmain"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center" android:padding="12dp"
                android:text="记入账本" android:textSize="14sp" android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_btn_primary"
                android:visibility="gone" />
            <TextView android:id="@+id/btn_td_rmmain"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center" android:padding="12dp"
                android:text="移出账本" android:textSize="13sp"
                android:textColor="@color/chip_text"
                android:background="@drawable/bg_btn_ghost"
                android:visibility="gone" />
        </LinearLayout>

        <TextView android:id="@+id/btn_td_delete"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:padding="8dp"
            android:layout_marginTop="4dp"
            android:text="删除出游（连同全部明细）" android:textSize="12sp"
            android:textColor="@color/danger" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:background="@color/divider"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="本次出游明细" android:textSize="13sp" android:textStyle="bold"
            android:textColor="@color/text_main" />

        <LinearLayout
            android:id="@+id/trip_records_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="4dp" />
    </LinearLayout>
</ScrollView>
