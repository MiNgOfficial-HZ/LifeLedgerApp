<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_card"
        android:elevation="1dp"
        android:padding="14dp">

        <LinearLayout android:id="@+id/trip_head"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:clickable="true" android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground">
            <TextView android:id="@+id/tv_trip_emoji"
                android:layout_width="42dp" android:layout_height="42dp"
                android:background="@drawable/bg_emoji"
                android:gravity="center" android:textSize="18sp" />
            <LinearLayout
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical"
                android:layout_marginStart="12dp" android:layout_marginEnd="8dp">
                <LinearLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical">
                    <TextView android:id="@+id/tv_trip_name"
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="15sp" android:textStyle="bold"
                        android:textColor="@color/text_main"
                        android:maxLines="1" android:ellipsize="end" />
                    <TextView android:id="@+id/tv_trip_status"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textSize="10sp" android:textStyle="bold"
                        android:paddingStart="8dp" android:paddingEnd="8dp"
                        android:paddingTop="3dp" android:paddingBottom="3dp" />
                </LinearLayout>
                <TextView android:id="@+id/tv_trip_range"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="12sp" android:textColor="@color/text_sub"
                    android:layout_marginTop="4dp" />
                <TextView android:id="@+id/tv_trip_tag"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="11sp" android:textColor="@color/chip_sel_text"
                    android:layout_marginTop="4dp" android:visibility="gone" />
            </LinearLayout>
            <TextView android:id="@+id/tv_trip_total"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="16sp" android:textStyle="bold"
                android:textColor="@color/expense" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_seg_track"
            android:padding="2dp">
            <TextView android:id="@+id/btn_trip_add"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center" android:padding="8dp"
                android:text="＋ 记一笔" android:textSize="12sp"
                android:textColor="@color/chip_sel_text" />
            <TextView android:id="@+id/btn_trip_detail"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center" android:padding="8dp"
                android:text="明细" android:textSize="12sp"
                android:textColor="@color/chip_text" />
            <TextView android:id="@+id/btn_trip_delete"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center" android:padding="8dp"
                android:text="删除" android:textSize="12sp"
                android:textColor="@color/danger" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
