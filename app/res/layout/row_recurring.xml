<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:background="@drawable/bg_card" android:elevation="1dp"
    android:padding="14dp" android:layout_marginBottom="10dp">

    <TextView android:id="@+id/tv_rr_emoji"
        android:layout_width="38dp" android:layout_height="38dp"
        android:background="@drawable/bg_emoji" android:gravity="center" android:textSize="16sp" />
    <LinearLayout
        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:orientation="vertical" android:layout_marginStart="10dp" android:layout_marginEnd="8dp">
        <TextView android:id="@+id/tv_rr_title"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="15sp" android:textStyle="bold" android:textColor="@color/text_main" />
        <TextView android:id="@+id/tv_rr_sub"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="11sp" android:textColor="@color/text_sub" android:layout_marginTop="2dp" />
    </LinearLayout>
    <TextView android:id="@+id/tv_rr_amount"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textSize="15sp" android:textStyle="bold" android:textColor="@color/text_main" />
    <ImageButton android:id="@+id/btn_rr_edit"
        android:layout_width="34dp" android:layout_height="34dp"
        android:src="@drawable/ic_edit" android:tint="@color/icon_gray"
        android:background="?android:attr/selectableItemBackgroundBorderless" />
    <ImageButton android:id="@+id/btn_rr_delete"
        android:layout_width="34dp" android:layout_height="34dp"
        android:src="@drawable/ic_delete" android:tint="@color/icon_gray"
        android:background="?android:attr/selectableItemBackgroundBorderless" />
</LinearLayout>
