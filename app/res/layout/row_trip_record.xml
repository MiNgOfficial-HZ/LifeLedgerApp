<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <TextView android:id="@+id/tv_trr_emoji"
        android:layout_width="34dp" android:layout_height="34dp"
        android:background="@drawable/bg_emoji"
        android:gravity="center"
        android:textSize="14sp" />
    <LinearLayout
        android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:orientation="vertical"
        android:layout_marginStart="10dp" android:layout_marginEnd="6dp">
        <TextView android:id="@+id/tv_trr_title"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="14sp" android:textStyle="bold"
            android:textColor="@color/text_main"
            android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/tv_trr_sub"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="12sp" android:textColor="@color/text_sub"
            android:layout_marginTop="2dp"
            android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
    <TextView android:id="@+id/tv_trr_amount"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textSize="15sp" android:textStyle="bold"
        android:textColor="@color/expense" />
    <ImageButton android:id="@+id/btn_trr_edit"
        android:layout_width="34dp" android:layout_height="34dp"
        android:src="@drawable/ic_edit" android:tint="@color/icon_gray"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:layout_marginStart="2dp" />
    <ImageButton android:id="@+id/btn_trr_delete"
        android:layout_width="34dp" android:layout_height="34dp"
        android:src="@drawable/ic_delete" android:tint="@color/icon_gray"
        android:background="?android:attr/selectableItemBackgroundBorderless" />
</LinearLayout>
